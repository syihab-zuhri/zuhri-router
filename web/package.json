{
  "name": "router-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:local": "node scripts/local-browser-verify.mjs",
    "test:dist": "node scripts/dist-browser-verify.mjs",
    "test:browser": "npm run build && npm run test:dist",
    "evidence:deps": "node scripts/dependency-report.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
